<!-- 3 Magic -->


mixin select_hermetic_technique(obj)
    +select(obj).select_1.select_hermetic_technique
        +option({class:"italic", value:"0 [@{technique_i18n}]", "data-i18n":"technique"}) Technique
        each technique in arm5.pug.hermetic.techniques
            +option({value: `(@{${technique}_score} + @{${technique}_puissant}) [@{${technique}_i18n}]`, 'data-i18n':technique})= helpers.titleCase(technique)

mixin select_hermetic_form(obj)
    +select(obj).select_1.select_hermetic_form
        +option({class:"italic", value:"0 [@{form_i18n}]", "data-i18n":"form"}) Form
        each form in arm5.pug.hermetic.forms
            +option({value: `(@{${form}_score} + @{${form}_puissant}) [@{${form}_i18n}]`, "data-i18n":form})= helpers.titleCase(form)


+hidden({name:"gestures", trigger:{calculation:"calcGestures"} })
+hidden({name:"gestures_label", trigger:{calculation:"calcGesturesLabel"} })
+hidden({name:"words", trigger:{calculation:"calcWords"} })
+hidden({name:"words_label", trigger:{calculation:"calcWordsLabel"} })
mixin hermetic_casting_parameters()
    h5(data-i18n="bonus").heading_label Bonus
    .kscaffold-compatible
        .config
            span(data-i18n="aura") Aura
            +number({name:"aura", value:3}).number_1

            - let trigger;

            span(data-i18n="gestures") Gestures
            +select({name: "gestures_raw", trigger}).select_1
                +option({"data-i18n": "gestures-exaggerated", value:"exaggerated", trigger:{affects:["gestures", "gestures_label"]} }).italic Exaggerated (+1)
                +option({"data-i18n":"gestures-bold", value:"bold", selected: true, trigger}).italic Bold
                +option({"data-i18n":"gestures-subtle", value:"subtle", trigger}).italic Subtle (-2)
                +option({"data-i18n":"gestures-none", value:"none", trigger}).italic None (-5)

            span(data-i18n="words") Words
            +select({name: "words_raw", trigger: {affects:["words", "words_label"]} }).select_1
                +option({"data-i18n":"words-loud", value:"loud"}).italic Loud (+1)
                +option({"data-i18n":"words-firm", value:"firm", selected:true}).italic Firm
                +option({"data-i18n":"words-quiet", value:"quiet"}).italic Quiet (-5)
                +option({"data-i18n":"words-none", value:"none"}).italic None (-10)

-
    const hermetic_parameters = {
        "@{gestures}": "@{gestures_label}",
        "@{words}": "@{words_label}",
        "@{aura}": "@{aura_i18n}",
    };

mixin hermetic_casting_row({name, display, ceremonial=false, divider, mode, critical})
    -
        if (typeof name !== "string") {
            throw new Error(`+hermetic_casting_row(): expected string name, got ${typeof name} object ${name}`);
        }
        if (typeof display !== "string") {
            throw new Error(`+hermetic_casting_row(): expected string 'display', got ${typeof display} object ${display}`);
        }
        if (divider !== null && (!Number.isInteger(divider) || divider <= 0)) {
            throw new Error(`+hermetic_casting_row(): expected divider to be null or a positive integer, got ${typeof divider} object ${divider}`);
        }
        if (typeof mode !== "string") {
            throw new Error(`+hermetic_casting_row(): expected string mode, got ${typeof mode} object ${mode}`);
        }
        const valid_criticals = ["critical", "critical-spontaneous"]
        if (!valid_criticals.includes(critical)) {
            throw new TypeError(`+hermetic_casting_row(): expected 'critical' to be one of ${valid_criticals}, got ${typeof critical} object ${critical}`);
        }

        const casting_total =  new RollTotal({
            score: {
                [`@{cast_${name}_technique}`]: null,
                [`@{cast_${name}_form}`]: null,
                [`[[@{cast_${name}_focus}]]`]: "@{focus_i18n}",
                "@{Stamina_Score}":  "@{stamina_i18n}",
                ...(ceremonial
                    ? {
                        [`@{cast_artes_lib}`]: "@{artes_i18n}",
                        [`@{cast_philos}`]: "@{philos_i18n}",
                    }
                    : {}
                ),
                ...hermetic_parameters,
            },
            divider: {
                ...(divider !== null ? {[`${divider}`]: null} : {}),
                [`[[1 + (@{cast_${name}_deficiency})]]`]: "@{deficiency_i18n}",
            },
            ...(divider
                ? {total_bonuses: {[`@{cast_${name}_total_bonus}`]: "@{bonus_i18n}"} }
                : {}
            )
        });
        const casting_roll = new Roll({
            template:"arcane",
            label:`^{casting}: ^{${name}}`,
            total: casting_total,
            fields:{
                "label1": "^{aura}",
                "result1": "@{aura}",
                "label2": "^{weakness-m}",
                "result2": inline_roll(casting_total.get_penalties()),
                "label3": "^{circumstances-m}",
                "result3": inline_roll(casting_total.get_modifiers()),
                "botch-button": "[@{botch_i18n}!](~@{character_name}|botch)",
                "crit-button": `[@{critical_i18n}!](~@{character_name}|${critical})`,
            },
        });
    tr
        td(data-i18n=name)= helpers.titleCase(display)
        td
            div.flex-container-center
                +am5_roll_button({name: `cast_${name}`, roll: casting_roll, mode: mode})
        td: +select_hermetic_technique({name: `cast_${name}_technique`})
        td: +select_hermetic_form({name: `cast_${name}_form`})
        td(style="text-align: center;")
            //- min() is computed as (a + b) - abs(a - b)
            +checkbox({name: `cast_${name}_focus`, value: `((@{cast_${name}_technique} + @{cast_${name}_form} - abs(@{cast_${name}_technique} - @{cast_${name}_form}))/2)`}).check
        td(style="text-align: center;")
            +checkbox({name: `cast_${name}_deficiency`, value: "1"}).check
        td: +number({name: `cast_${name}_sta`, value: "@{Stamina_Score}", disabled: "true"}).number_2
        td: +number({name: `cast_${name}_aura`, value: "@{aura}", disabled: "true"}).number_2
        if ceremonial
            td: +number({name: `cast_artes_lib`, value: 0}).number_2
            td: +number({name: `cast_philos`, value: 0}).number_2
        else
            td
            td
        if divider !== null
            td: +number({name: `cast_${name}_total_bonus`, value: 0}).number_2
        else
            td



