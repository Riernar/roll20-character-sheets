+module.
    const calcGestures = function ({attributes}) {
        const gestures = helpers.get(attributes, "gestures_raw");
        const map = {
            "exaggerated": 1,
            "bold": 0,
            "subtle": -2,
            "none": -5,
        };
        const result = helpers.get(map, gestures);
        console.log({func:"calcGestures", attributes, gestures, map, result});
        return result;
    };
    k.registerFuncs({calcGestures});

    const calcGesturesLabel = function ({attributes}) {
        const gestures = helpers.get(attributes, "gestures_raw");
        return `@{gestures_i18n}: @{${gestures}_i18n}`;
    };
    k.registerFuncs({calcGesturesLabel});

    const calcWords = function ({attributes}) {
        const words = helpers.get(attributes, "words_raw");
        const map = {
            "loud": 1,
            "firm": 0,
            "quiet": -5,
            "none": -10,
        };
        return helpers.get(map, words);
    };
    k.registerFuncs({calcWords});

    const calcWordsLabel = function ({attributes}) {
        const words = helpers.get(attributes, "words_raw");
        return `@{words_i18n}: @{${words}_i18n}`;
    };
    k.registerFuncs({calcWordsLabel});

