<!-- 2 Characteristics & Abilities -->

mixin characteristic_row({characteristic, affects})
    tr
        -
            const total = new RollTotal({
                score:{
                    [`@{${characteristic}_score}`]: `@{${characteristic}_i18n}`
                }
            });
            const roll = new Roll({
                template: "ability",
                label: `^{${characteristic}}`,
                total,
                fields: {
                    "name": "@{character_name}",
                    "banner": `@{${characteristic}_description}`,
                    "label1": "^{score}",
                    "result1": `@{${characteristic}_score}`,
                    "label2": "^{weakness-m}",
                    "result2": inline_roll(total.get_penalties()),
                    "label3": "^{circumstances-m}",
                    "result3": inline_roll(total.get_modifiers()),
                    "botch-button": "[@{botch_i18n}!](~@{character_name}|botch)",
                    "crit-button": "[@{critical_i18n}!](~@{character_name}|critical)",
                },
            });
        div.characteristic-row
            div.roll-column: +am5_roll_button({name: characteristic, roll, mode:"simple+stress"})
            div.characteristic-column(data-i18n=characteristic)= helpers.titleCase(characteristic)
            div.description-column: +text({name: `${characteristic}_description`}).heading_2
            div.score-column: +number({name: `${characteristic}_score`, trigger:{affects}, value: 0}).number_1
            div.aging-column: +number({name: `${characteristic}_aging`, value:0}).number_1

mixin select_characteristics(obj)
    +select(obj)&attributes(attributes)
        block
        each characteristic in arm5.pug.characteristics.all
            +option({value: characteristic, "data-i18n": characteristic})= helpers.titleCase(characteristic)


