+scss.
    .characteristics-grid {
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr) auto auto;
        column-gap: 0.5ch;
        width: 100%;

        .grid-separator {
            grid-column: 1 / -1;
            height: 1px;
            margin: 1rem 0;
            background: #53332a;
        }

        * {
            font-family: "Macondo", cursive;
            font-size: 14px;
            font-weight: bold;
            color: #53332a;
        }
        .characteristic-column {
            font-variant: small-caps;
        }


        .heading_2 {
            width: 100%;
            min-width: 10ch;
        }

        .characteristic-row {
            display: contents;
        }

        .roll-column {
            white-space: nowrap;
        }

        .roll-column > .die-container {
            flex-wrap: nowrap;
        }
    }

    .ability-characteristic-short {
        width:25px;
        background: transparent;
        border: none;
        text-align: center;
        color: #53332a;
        font-variant: small-caps;
        font-family: Macondo, cursive;
        font-weight: bold;
        font-size: 14px;
        padding: 4px 0px;
    }

+module.
    const calc_ability_short_charact = function({trigger, attributes}) {
        const [section,id] = k.parseTriggerName(trigger.name);
        const charact_name = helpers.get(attributes, `${section}_${id}_ability_characname`);
        const result = helpers.get({
            "global": "gbl",
            "ask": "ask",
            "intelligence": "int",
            "perception": "per",
            "presence": "pre",
            "communication": "com",
            "strength": "str",
            "stamina": "sta",
            "dexterity": "dex",
            "quickness": "qik",
        }, charact_name);
        console.log({func: "calc_ability_short_charact", trigger, attributes, section, id, charact_name, result});
        return result
    };
    k.registerFuncs({calc_ability_short_charact});

    const calc_ability_charact_value = function({trigger, attributes}) {
        const [section,id] = k.parseTriggerName(trigger.name);
        const characteristic = helpers.get(attributes, `${section}_${id}_ability_characname`);
        const global_characteristic = helpers.get(attributes, "global_ability_characteristic");
        const result =  (() => {
            if (characteristic === "global") {
                return `@{${global_characteristic}_score}`;
            }
            if (characteristic === "ask") {
                const choices = arm5.sheet.characteristics.all.map(
                    char => `@{${char}_i18n},(@{${char}_score} [@{${char}_i18n}])`
                ).join("|")
                return `(?{@{characteristic_i18n}|${choices}})`
            }
            return `@{${characteristic}_score}`;
        })();
        console.log({func: "calc_ability_charact_value", trigger, attributes, section, id, characteristic, global_characteristic, result});
        return result;
    };
    k.registerFuncs({calc_ability_charact_value});

    const calc_ability_charact_label = function({trigger, attributes}) {
        const [section,id] = k.parseTriggerName(trigger.name);
        const characteristic = helpers.get(attributes, `${section}_${id}_ability_characname`);
        const global_characteristic = helpers.get(attributes, "global_ability_characteristic");
        const result =  (() => {
            if (characteristic === "global") {
                return `@{${global_characteristic}_i18n}`;
            }
            if (characteristic === "ask") {
                return "^{ask}"
            }
            return `@{${characteristic}_i18n}`;
        })();
        console.log({func: "calc_ability_charact_label", trigger, attributes, section, id, characteristic, global_characteristic, result});
        return result;

    };
    k.registerFuncs({calc_ability_charact_label});